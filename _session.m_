      56 +    public function storeInstruction(Request $request, Stay $st
         +ay): RedirectResponse                                          
      57 +    {                                                          
      58 +        $doctor = auth()->user();                              
      59 +                                                               
      60 +        $isAssigned = $stay->currentDoctors()->where('doctor_id
         +', $doctor->id)->exists();                                     
      61 +                                                               
      62 +        if (! $isAssigned) {                                   
      63 +            abort(403, 'Solo puedes escribir instrucciones para
         + pacientes asignados a ti.');                                  
      64 +        }                                                      
      65 +                                                               
      66 +        $request->validate([                                   
      67 +            'body' => 'required|string|max:3000',              
      68 +        ], [                                                   
      69 +            'body.required' => 'La instrucción no puede estar v
         +acía.',                                                        
      70 +            'body.max'      => 'La instrucción no puede superar
         + 3,000 caracteres.',                                           
      71 +        ]);                                                    
      72 +                                                               
      73 +        StayInstruction::create([                              
      74 +            'stay_id'   => $stay->id,                          
      75 +            'doctor_id' => $doctor->id,                        
      76 +            'body'      => $request->body,                     
      77 +        ]);                                                    
      78 +                                                               
      79 +        return back()->with('success', 'Instrucción registrada 
         +correctamente.');                                              
      80 +    }                                                          
